# Copy this file to .env and fill it. NEVER commit .env (it is in .gitignore).
#
# demo = fake Chitragupt / fake T3-T4 nodes / sample NMS data (any laptop)
# live = real Airtel systems (only on Airtel network / internal VM)
PEYTO_MODE=demo

# How people log in:
#   olm     = each user types OLM ID + password + OTP in the Peyto UI (nothing saved)
#   service = bot uses the service accounts below (only if IT gives IDs without OTP)
PEYTO_AUTH=olm

# ---------------- live mode only ----------------
# Chitragupt link from the address bar
CHITRAGUPT_URL=
# Only for PEYTO_AUTH=service (never put your personal OLM password here)
CHITRAGUPT_USER=
CHITRAGUPT_PASS=

# SSH to T3 / T4 MPLS nodes (the PuTTY step).
# PEYTO_AUTH=olm uses the logged-in OLM ID; these are only for service mode.
SSH_USER=
SSH_PASS=
# Comma separated node IPs, optional :port
SSH_T3_NODES=
SSH_T4_NODES=
# If PuTTY first goes to a jump / bastion server, put it here (host:port)
SSH_JUMP_HOST=
SSH_JUMP_USER=
SSH_JUMP_PASS=

# Folder with files exported from LightSoft NMS (see backend/config/nms_export.yaml)
NMS_EXPORT_DIR=

# Demo mode: start fake systems inside the app (1 = yes)
PEYTO_AUTOSTART_MOCKS=1
