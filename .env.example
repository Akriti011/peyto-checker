# Copy this file to .env and fill it. NEVER commit .env (it is in .gitignore).
#
# demo = fake Chitragupt / fake T3-T4 nodes / sample NMS data (any laptop)
# live = real Airtel systems (only on Airtel network / internal VM)
PEYTO_MODE=demo

# ---------------- live mode only ----------------
# Chitragupt: link from the address bar, and a READ-ONLY service account (not a personal ID)
CHITRAGUPT_URL=
CHITRAGUPT_USER=
CHITRAGUPT_PASS=

# SSH to T3 / T4 MPLS nodes (the PuTTY step). Read-only account.
SSH_USER=
SSH_PASS=
# Comma separated node IPs, optional :port
SSH_T3_NODES=
SSH_T4_NODES=
# If PuTTY first goes to a jump / bastion server, put it here (host:port)
SSH_JUMP_HOST=
SSH_JUMP_USER=
SSH_JUMP_PASS=

# Folder with files exported from LightSoft NMS (see backend/config/nms_export.yaml)
NMS_EXPORT_DIR=

# Demo mode: start fake systems inside the app (1 = yes)
PEYTO_AUTOSTART_MOCKS=1
